LOCAL_CBT_SECRET_KEY=replace-with-random-local-secret-at-least-32-characters
LOCAL_CBT_DEBUG=false
LOCAL_CBT_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
LOCAL_CBT_DATABASE=data/local-cbt.sqlite3
LOCAL_CBT_TIME_ZONE=Africa/Lagos
LOCAL_CBT_TOKEN_TTL_HOURS=12
LOCAL_CBT_LOGIN_RATE=20/minute
# Set to the exact trusted reverse-proxy count only when proxy headers are stripped/replaced by that proxy.
LOCAL_CBT_NUM_PROXIES=0
LOCAL_CBT_MAX_SYNC_RETRIES=12
LOCAL_CBT_SYNC_BATCH_SIZE=25
CBT_PACKAGE_SIGNING_KEY=configure-the-same-random-central-package-key
CBT_LICENSE_SIGNING_KEY=configure-the-same-central-license-signing-key
CENTRAL_SYNC_URL=https://your-school-api.example.com
CENTRAL_SYNC_TOKEN=one-time-central-local-server-token
CENTRAL_SYNC_VERIFY_TLS=true
