# Safe local defaults. Copy to .env; do not commit .env.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Development default: local SQLite database at backend/db.sqlite3.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# For deployment, use PostgreSQL and provide credentials via the deployment
# secret manager. Set DJANGO_DEBUG=false as well.
# DB_ENGINE=postgresql
# DB_NAME=school_management
# DB_USER=school_management
# DB_PASSWORD=replace-with-a-secure-deployment-secret
# DB_HOST=127.0.0.1
# DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
DJANGO_LOG_LEVEL=INFO
# Set this only when HTTPS is correctly configured in production.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# JWT: access stays in frontend memory; refresh is an HttpOnly cookie.
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_COOKIE_NAME=school_refresh
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Optional, for a same-site frontend/API split across subdomains.
# AUTH_REFRESH_COOKIE_DOMAIN=.example.com

# Local development captures email in memory. Configure SMTP via the EMAIL_*
# settings in deployment to deliver account setup and password reset messages.
DEFAULT_FROM_EMAIL=School Management <noreply@example.com>
PASSWORD_RESET_TIMEOUT=3600
FRONTEND_BASE_URL=http://localhost:5173
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
