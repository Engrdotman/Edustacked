# Safe local defaults. Copy to .env; do not commit .env.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local verification/reset emails are printed in the backend terminal.
# To deliver real mail locally, configure SendGrid or SMTP instead.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# New school sign-up alerts go to this EDUstacked inbox (local console backend prints them).
PLATFORM_SIGNUP_NOTIFICATION_EMAIL=edustackedng@gmail.com
# New demo and assisted-onboarding requests are emailed to this inbox.
PLATFORM_DEMO_REQUEST_NOTIFICATION_EMAIL=edustackedng@gmail.com
# Optional active SendGrid Dynamic Template for verification messages.
# Railway value starts with d-; the template receives `verification_url`.
# SENDGRID_VERIFICATION_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional SendGrid Dynamic Template for staff account setup/password reset.
# Its dynamic data includes `password_setup_url`, `first_name`, `full_name`, and `school_name`.
# Set the same variable in Railway to use the template in production.
# SENDGRID_PASSWORD_SETUP_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional SendGrid Dynamic Template for new-school alerts to EDUstacked.
# Template data: school_name, administrator_name, administrator_email, school_email,
# school_phone, school_type, country, state, local_government_area,
# verification_status, registered_at, review_url.
# SENDGRID_SCHOOL_SIGNUP_NOTIFICATION_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional SendGrid Dynamic Template for demo and assisted-onboarding request alerts.
# Template data: request_id, school_name, administrator_name, requester_email,
# phone_number, request_message, received_at, support_email.
# SENDGRID_DEMO_REQUEST_NOTIFICATION_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional shared cache for deployed API workers. Leave unset for local development/CI.
# Set on Railway backend to the Redis service's private URL reference. Check
# /api/v1/health/ after deployment: cache.backend should be redis and status connected.
# REDIS_URL=redis://127.0.0.1:6379/0

# Development default: local SQLite database at backend/db.sqlite3.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# For deployment, use PostgreSQL and provide credentials via the deployment
# secret manager. Set DJANGO_DEBUG=false as well.
# DB_ENGINE=postgresql
# DB_NAME=school_management
# DB_USER=school_management
# DB_PASSWORD=replace-with-a-secure-deployment-secret
# DB_HOST=127.0.0.1
# DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
DJANGO_LOG_LEVEL=INFO
# Set this only when HTTPS is correctly configured in production.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# CI sets this false for Django's plain-HTTP test client; keep true on Railway.
DJANGO_SECURE_SSL_REDIRECT=true

# JWT: access stays in frontend memory; refresh is an HttpOnly cookie.
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_DAYS=7
AUTH_LOGIN_RATE=10/minute
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_REFRESH_COOKIE_NAME=school_refresh
# Local development defaults to Lax. In Railway for a separate Vercel domain, set both cookie policies to None.
AUTH_REFRESH_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Optional, for a same-site frontend/API split across subdomains.
# AUTH_REFRESH_COOKIE_DOMAIN=.example.com

# For SendGrid Web API delivery, set the backend and API key below.
# SendGrid requires a verified sender/domain.
# EMAIL_BACKEND=apps.core.sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=SG.replace-with-a-secret-api-key
# SENDGRID_SANDBOX_MODE=false
# For SMTP delivery instead, configure EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER,
# EMAIL_HOST_PASSWORD, and EMAIL_USE_TLS below.
DEFAULT_FROM_EMAIL="EDUstacked <edustackedng@gmail.com>"
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400
FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated capabilities that require platform verification.
SCHOOL_VERIFIED_REQUIRED_CAPABILITIES=integrations.manage
# Optional until a Paystack test/live account is configured. Keep this server-side.
# PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
# Optional until a Flutterwave test/live account is configured. Keep this server-side.
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-with-your-test-secret
# Webhook secrets are verified by the API. Paystack defaults to its secret key when omitted.
# PAYSTACK_WEBHOOK_SECRET=sk_test_or_live_replace-with-your-paystack-webhook-secret
# Flutterwave webhook verification uses the Secret Hash configured in its dashboard.
# FLUTTERWAVE_WEBHOOK_SECRET=replace-with-your-flutterwave-webhook-secret-hash
# Termii SMS delivery for school-fee acknowledgements and receipt verification codes.
# Add the real API token and approved sender ID only to Railway's backend variables.
# TERMII_API_KEY=replace-with-your-termii-api-token
TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_SENDER_ID=EDUstacked
TERMII_CHANNEL=generic
# Optional Bachs hosted checkout. Use sandbox credentials locally and live credentials in production.
# Local sandbox: BACHS_API_BASE_URL=https://sandbox-api.bachs.io/v1
# Production: BACHS_API_BASE_URL=https://api.bachs.io/v1
# BACHS_API_KEY=sk_sandbox_replace_with_your_bachs_api_key
# BACHS_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
# Optional public HTTPS return page for local development (for example, a temporary frontend tunnel).
# BACHS_RETURN_URL=https://your-public-frontend.example/app/billing
# Register https://your-api-host/api/v1/billing/bachs/webhook/ in Bachs and subscribe to
# collection.succeeded, collection.failed, and checkout.expired events.
# CBT license/package signing keys must be stable random server secrets. The local CBT server
# needs the matching keys; configure explicitly before issuing packages.
CBT_LICENSE_SIGNING_KEY=replace-with-a-stable-random-license-signing-key
CBT_PACKAGE_SIGNING_KEY=replace-with-a-separate-random-package-signing-key
CBT_OFFLINE_GRACE_DAYS=7
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
