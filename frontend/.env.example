# Local development uses the Vite /api proxy; leave VITE_API_BASE_URL empty.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=

# In Vercel/Netlify, use /api. vercel.json/netlify.toml proxy that path to Railway,
# keeping authentication cookies first-party on mobile browsers.
# For Render, the server.js Express server proxies /api to the backend.
# VITE_API_BASE_URL=/api (for Render production, set via environment variable)
# VITE_ variables are public build-time values. Never put secrets here.
