# Local development uses the Vite /api proxy; leave VITE_API_BASE_URL empty.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=

# Production frontend requests use the same-origin /api path.
# - Render: Express server (server.js) proxies /api/* to the Railway API
# - Vercel/Netlify: Static rewrites in vercel.json/netlify.toml forward /api/* to Railway
# VITE_ variables are public build-time values. Never put secrets here.
