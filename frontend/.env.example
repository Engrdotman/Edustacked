# Local development uses the Vite /api proxy; leave VITE_API_BASE_URL empty.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# In Vercel, use /api. frontend/vercel.json proxies that path to Railway,
# keeping authentication cookies first-party on mobile browsers.
# For local development, leave this empty to use the Vite /api proxy.
# VITE_API_BASE_URL=/api
# VITE_ variables are public build-time values. Never put secrets here.
